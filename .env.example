# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# Required. Gemini API key (paid tier recommended; see README for why).
GEMINI_API_KEY=

# Optional. Only needed to enable the Jev quality meter.
TYPESAFE_API_KEY=

# Required. Password for /admin. At least 8 characters (Glosa refuses to
# start otherwise) -- use a long random one, e.g.:
#   openssl rand -base64 18
ADMIN_PASSWORD=
